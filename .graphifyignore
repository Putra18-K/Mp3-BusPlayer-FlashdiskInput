# Graphify ignore — build artifacts, cache, local config, and sensitive files.
# Matches the requirements in CLAUDE.md: never index build/cache/sensitive content.

# Version control & tool dirs
.git/
.gradle/
.idea/
.clion/
.cache/

# Build output (ESP-IDF)
build/
app/build/
components/*/build/
managed_components/
dependencies.lock
sdkconfig
sdkconfig.old
sdkconfig.defaults.esp32s3
.flash?  # nothing normally; placeholder only

# Language/tool caches
node_modules/
__pycache__/
*.pyc
*.pyo

# Graphify output
graphify-out/

# Compiled / intermediate files
*.o
*.obj
*.a
*.elf
*.bin
*.hex
*.map
*.d
*.lst
*.su
*.swp
*.swo
*.class
*.jar

# Logs & caches
*.log
*.tmp
*.cache
logs/
*.pid
*.bak

# Local & environment config
.env
.env.*
!*.env.example
local.properties
*.local
secrets*
*key*
*.pem
*.p12
*.jks
credentials.json
config.local.*
